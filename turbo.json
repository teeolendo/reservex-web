{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NEXT_PUBLIC_TRADER_URL", "NEXT_PUBLIC_LABS_URL", "NEXT_PUBLIC_WAITLIST_ENDPOINT", "NEXT_PUBLIC_CONTACT_EMAIL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "dist/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] },
    "test": {}
  }
}
